{
  "name": "api-replay",
  "version": "0.1.0",
  "private": true,
  "description": "Compare JSON responses across two API environments in your browser or terminal.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "compare": "node dist/src/cli.js",
    "demo": "node dist/src/demo.js",
    "ui": "npm run build && node dist/src/ui.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
